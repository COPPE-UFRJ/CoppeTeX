% \begin{macro}{\dedication}
%    \begin{macrocode}
% A 2.6, a 3.1.2.2.1 e a 3.1.2.2.3 recomendam dedicatoria e epigrafe com
% alinhamento do MEIO da mancha grafica ate a margem direita, na parte inferior
% da folha: o bloco ocupa a metade direita da mancha, e o texto, alinhado a
% esquerda, comeca no meio dela, a 11 cm da borda. A dedicatoria saia num bloco
% de 60 mm encostado na margem direita, com o texto alinhado a direita, e
% comecava perto de 13 cm; a epigrafe ja tinha a meia mancha, mas tambem com o
% texto alinhado a direita (#123).
\newcommand\dedication[1]{%
  \gdef\@dedic{#1}%
  \cleardoublepage
  \vspace*{\fill}%
  \begin{flushright}
    \begin{minipage}{0.5\textwidth}
      \raggedright\itshape\normalsize \@dedic
    \end{minipage}
  \end{flushright}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\epigrafe}
% A epigrafe da 3.1.2.2.3: uma citacao com a autoria, numa folha propria,
% depois dos agradecimentos, "com alinhamento no meio da pagina ou folha ate a
% margem direita, na parte inferior" -- o mesmo lugar da dedicatoria. Na parte
% pre-textual "nao e necessario seguir a norma de citacao", entao a autoria vai
% so abaixo do texto, alinhada a direita. O texto em si comeca no meio da
% mancha, como o da dedicatoria (#123).
%    \begin{macrocode}
\newcommand\epigrafe[2]{%
  \cleardoublepage
  \vspace*{\fill}%
  \begin{flushright}
    \begin{minipage}{0.5\textwidth}
      \raggedright\itshape\normalsize #1\par
      \vspace{1ex}{\raggedleft\normalfont\small #2\par}
    \end{minipage}
  \end{flushright}}
%    \end{macrocode}
% \end{macro}
