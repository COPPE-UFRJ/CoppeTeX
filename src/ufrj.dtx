% \begin{macro}{\department}
% Escolhe o Programa pela sigla, entre os que a unidade declarou com
% |\ufrjdeclareprogram|. Uma sigla que ninguém declarou é erro, e o erro diz
% isso, em vez de a capa sair sem o nome do Programa.
%    \begin{macrocode}
\newcommand\ufrj@deptcode{}
\newcommand\meta@deptname{}
\newcommand\department[1]{%
% \local@deptname e o nome da capa e da folha de rosto, \meta@deptname o que vai
% para o XMP e \foreign@deptname o da folha do abstract. Os dois primeiros tem o
% mesmo texto desde que a classe inteira passou a UTF-8; continuam dois nomes
% porque o XMP e escrito por \write e a capa e composta, e quem mexer num dos dois
% caminhos nao deve ter de pensar no outro.
%
% \let, e nao \def com o texto: o nome sai da tabela da unidade exatamente como
% ela o declarou, e a capa recebe a mesma sequencia de tokens que recebia quando
% os nomes estavam escritos aqui dentro.
  \gdef\ufrj@deptcode{#1}%
  \@ifundefined{ufrj@prog@#1@brazilian}{%
    \ClassError{ufrj}{Programa `#1' nao declarado}{%
      A sigla dada a \string\department\space tem de ser a de um\MessageBreak
      Programa declarado pelo estilo da unidade, com\MessageBreak
      \string\ufrjdeclareprogram.}%
  }{%
    \ufrj@gletcs\local@deptname{ufrj@prog@#1@brazilian}%
    \ufrj@gletcs\meta@deptname{ufrj@prog@#1@brazilian}%
    \ufrj@gletcs\foreign@deptname{ufrj@prog@#1@english}}}
% \global\let de uma macro para outra dada pelo nome.
\newcommand\ufrj@gletcs[2]{%
  \expandafter\global\expandafter\let\expandafter#1\csname #2\endcsname}
%    \end{macrocode}
