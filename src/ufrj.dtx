% \begin{macro}{\makelosiglas}
% \begin{macro}{\printlosiglas}
% \begin{macro}{\acron}
% A 3.1.2.2.6 do Manual: "Recomenda-se a elaboracao de listas separadas" de
% abreviaturas e de siglas (issue 101). |\makelosiglas|, no preambulo, abre a lista
% de siglas, com arquivo proprio (.sgx, ordenado pelo makeindex em .lsg);
% |\printlosiglas| a imprime; |\acron[chave]{SIGLA}{significado}| registra uma
% sigla, e |\sigla| passa a registrar por ele.
%
% Sem |\makelosiglas|, |\acron| manda a sigla para a lista de abreviaturas, como
% a classe sempre fez, e o titulo dela continua "Abreviaturas e Siglas". Assim
% um trabalho escrito antes nao perde entrada nenhuma: separar e pedido, nao
% efeito colateral. Com |\makelosiglas| o titulo vira so "Abreviaturas".
%
% Ordem: alfabetica, como a das abreviaturas -- a 3.1.2.2.6 fala em "relacao
% alfabetica".
%    \begin{macrocode}
\newif\if@ufrjsiglas \@ufrjsiglasfalse
\def\makelosiglas{%
  \newwrite\@lsgfile
  \immediate\openout\@lsgfile=\jobname.sgx
  \global\@ufrjsiglastrue
  \typeout{Writing index of acronyms file \jobname.sgx}%
  \let\makelosiglas\@empty}
\@onlypreamble\makelosiglas
\newcommand\@wrsgx[3]{%
  \protected@write\@lsgfile{}%
    {\string\indexentry{#1[#2] #3|ufrj@semfolio}{\thepage}}%
  \endgroup
  \@esphack}
\newcommand\acron[3][]{%
  \if@ufrjsiglas
    \@bsphack\begingroup
    \ifstrempty{#1}{\def\@tempsymbl{#2=}}{\def\@tempsymbl{#1=}}%
    \@sanitize
    \@wrsgx{\@tempsymbl}{#2}{#3}%
  \else
    \@ifundefined{abbrev}{}{\abbrev[#1]{#2}{#3}}%
  \fi}
\newcommand\printlosiglas{%
\begingroup\@ufrjglosspretrue
\renewcommand\glossaryname{\listsiglaname}%
\@input@{\jobname.lsg}\endgroup}
% O glossario da 3.1.4.2, em duas formas. A MANUAL e o ambiente theglossary,
% com um \item[termo] por entrada, na ordem em que o autor os escrever. A
% AUTOMATICA e esta: \makeglossarylist no preambulo, \glossaryterm onde o termo
% aparece no texto, \printglossarylist depois das referencias. Os termos vao
% para \jobname.gsx, o makeindex os ordena em ordem alfabetica com o ufrj.ist
% (\jobname.lgs), e a lista sai no mesmo theglossary, com titulo "Glossario" e
% entrada no sumario -- e o que a forma manual produz, sem o autor ordenar nada.
% Os nomes evitam os do pacote glossaries (\makeglossaries, \printglossary) e
% os do proprio LaTeX (\makeglossary, \glossary).
\def\makeglossarylist{%
  \newwrite\@gsxfile
  \immediate\openout\@gsxfile=\jobname.gsx
  \typeout{Writing glossary file \jobname.gsx}%
  \let\makeglossarylist\@empty}
\@onlypreamble\makeglossarylist
\newcommand\@wrgsx[3]{%
  \protected@write\@gsxfile{}%
    {\string\indexentry{#1[#2] #3|ufrj@semfolio}{\thepage}}%
  \endgroup
  \@esphack}
% Sem chave, a chave e o proprio termo SEM ACENTO (\ufrj@glosskey, junto da
% chave do indice): com o acento, "Arvore" caia depois de "Zebra".
\newcommand\glossaryterm[3][]{%
  \ifdefined\@gsxfile
    \@bsphack\begingroup
    \ifstrempty{#1}{\ufrj@glosskey{#2}}{\def\@tempsymbl{#1=}}%
    \@sanitize
    \@wrgsx{\@tempsymbl}{#2}{#3}%
  \else
    \ClassWarning{ufrj}{\string\glossaryterm\space sem
      \string\makeglossarylist\space no preambulo: o termo `#2' nao entra
      no glossario}%
  \fi}
\newcommand\printglossarylist{%
  \begingroup
  \renewcommand\glossaryname{\ufrjstring{glossary}}%
  \@input@{\jobname.lgs}%
  \endgroup}
% O makeindex rodado pela classe. As listas de abreviaturas, siglas e simbolos
% e o indice remissivo so aparecem depois do makeindex, entre uma passada e a
% seguinte. O latexmk (e o Overleaf) fazem isso pelo latexmkrc, mas o comando
% padrao do TeXstudio, do TeXworks e de quase todo editor roda so o pdflatex:
% as listas e o indice saiam VAZIOS, sem aviso nenhum.
%
% Agora a propria classe roda o makeindex, depois que a ultima pagina sai --
% antes disso as entradas da ultima pagina ainda nao foram escritas --, como o
% pacote imakeidx faz. Basta o shell escape RESTRITO, que o MiKTeX e o TeX Live
% ligam por padrao: o makeindex esta na lista de programas que ele permite.
% Sem shell escape nenhum, nada acontece e vale o latexmk. As listas usam o
% ufrj.ist; o indice, o estilo padrao. Com imakeidx, o indice fica com ele.
% Rodar de novo o que o latexmk ja rodou nao muda nada: a saida e a mesma.
\RequirePackage{shellesc}
\newcommand\ufrj@makeindex[3]{% #1 arquivo de escrita, #2 entrada, #3 estilo
  \ifdefined#1%
    \immediate\closeout#1%
    \ShellEscape{makeindex -q #3 -o \jobname.#2 \jobname.\csname ufrj@ext@#2\endcsname}%
  \fi}
\def\ufrj@ext@lab{abx}
\def\ufrj@ext@los{syx}
\def\ufrj@ext@lsg{sgx}
\def\ufrj@ext@lgs{gsx}
\def\ufrj@ext@ind{idx}
\newcommand\ufrj@makeindexauto{%
  \if@ufrjmakeindex
    \ifdefined\pdf@shellescape
      \ifnum\pdf@shellescape>\z@
        \ufrj@makeindex\@labfile{lab}{-s ufrj.ist}%
        \ufrj@makeindex\@losfile{los}{-s ufrj.ist}%
        \ufrj@makeindex\@lsgfile{lsg}{-s ufrj.ist}%
        \ufrj@makeindex\@gsxfile{lgs}{-s ufrj.ist}%
        \@ifpackageloaded{imakeidx}{}{%
          \ufrj@makeindex\@indexfile{ind}{}}%
      \fi
    \fi
  \fi}
\AddToHook{enddocument/afterlastpage}{\ufrj@makeindexauto}
% A chave de ordenacao das entradas do indice. O makeindex ordena pelos BYTES,
% e em UTF-8 toda letra acentuada vem depois do z: "Árvore", "ética" e "índice"
% saiam no fim do indice, depois de "Zebra". A NBR 6034 pede ordem alfabetica.
% A solucao de sempre e escrever a chave a mao, \index{indice@índice}; a classe
% agora faz isso sozinha: cada nivel da entrada (separado por !) que tem letra
% acentuada e nao tem chave propria (@) ganha uma, a mesma palavra sem acento.
% Entrada com aspas (o escape do makeindex) passa como esta. A parte depois de
% | (see, seealso, textbf, os intervalos) nao e tocada. Chave escrita pelo autor
% sempre vence. Vale para o makeidx e para o imakeidx, no pdfLaTeX e no
% LuaLaTeX. As listas de simbolos e abreviaturas nao passam por aqui: tem
% chave propria, o argumento opcional de \symbl e \abbrev (issue 52).
\ExplSyntaxOn
\str_new:N \l__ufrj_idx_str
\str_new:N \l__ufrj_idx_enc_str
\str_new:N \l__ufrj_idx_lvl_str
\str_new:N \l__ufrj_idx_key_str
\str_new:N \l__ufrj_idx_out_str
\seq_new:N \l__ufrj_idx_seq
\seq_new:N \l__ufrj_idx_out_seq
\cs_new:Npn \__ufrj_idx_enc:w #1 | #2 \q_stop
  {
    \str_set:Nn \l__ufrj_idx_str {#1}
    \str_set:Nn \l__ufrj_idx_enc_str { | #2 }
  }
\cs_new_protected:Npn \__ufrj_idx_strip:N #1
  {
    \clist_map_inline:nn
      {
        {á}{a}, {à}{a}, {â}{a}, {ã}{a}, {ä}{a},
        {é}{e}, {è}{e}, {ê}{e}, {ë}{e},
        {í}{i}, {ì}{i}, {î}{i}, {ï}{i},
        {ó}{o}, {ò}{o}, {ô}{o}, {õ}{o}, {ö}{o},
        {ú}{u}, {ù}{u}, {û}{u}, {ü}{u},
        {ç}{c}, {ñ}{n},
        {Á}{A}, {À}{A}, {Â}{A}, {Ã}{A}, {Ä}{A},
        {É}{E}, {È}{E}, {Ê}{E}, {Ë}{E},
        {Í}{I}, {Ì}{I}, {Î}{I}, {Ï}{I},
        {Ó}{O}, {Ò}{O}, {Ô}{O}, {Õ}{O}, {Ö}{O},
        {Ú}{U}, {Ù}{U}, {Û}{U}, {Ü}{U},
        {Ç}{C}, {Ñ}{N}
      }
      { \str_replace_all:Nnn #1 ##1 }
  }
\cs_new_protected:Npn \ufrj@idxkey #1
  {
    \str_set:Nn \l__ufrj_idx_str {#1}
    \str_if_in:NnTF \l__ufrj_idx_str { " }
      { \str_set_eq:NN \l__ufrj_idx_out_str \l__ufrj_idx_str }
      {
        \str_clear:N \l__ufrj_idx_enc_str
        \str_if_in:NnT \l__ufrj_idx_str { | }
