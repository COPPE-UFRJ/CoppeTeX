\newcommand\ufrj@toptext[1]{%
  \noindent \@nameuse{ufrj@str@#1@abstractname}\
  \ifthenelse{\boolean{maledoc}}%
    {\@nameuse{ufrj@str@#1@abstractofmale}}%
