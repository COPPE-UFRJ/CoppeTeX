\RequirePackage{longtable}     % tabelas que quebram entre páginas
\RequirePackage{etoolbox}
\RequirePackage{ltxcmds}
\RequirePackage{hologo}        % TeX-family logos: \hologo{TeX}, \hologo{LaTeX}, ...
