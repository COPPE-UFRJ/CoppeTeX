% \subsubsection{As folhas de identificação}
%
% \begin{macro}{\makecover}
% The ABNT cover (capa, NBR 14724) suggested in the manual's Anexo A. It is
% the institution block --- the university, the unit as |\ufrjdeclareunit|
% wrote it for the cover, and the graduate program taken from |\department| ---
% followed by the author, the title, and the city and year, all centred and
% uppercased. The logos declared with |\ufrjdeclarelogos| head the page. The
% capa is not counted: it precedes the (roman) front matter and is produced
% before the |titlepage| (folha de rosto).
%    \begin{macrocode}
\newcommand\makecover{%
  \begin{titlepage}%
% A capa e um modelo institucional, e sai em espaco simples qualquer que seja o
% espacamento do corpo. Sob a opcao doublespacing ela transbordava para uma
% segunda e ate uma terceira folha -- que ainda por cima levavam folio, porque
% o \thispagestyle do titlepage vale por uma pagina so. O \pagestyle{empty} e
% local ao ambiente e cobre quantas paginas forem.
  \pagestyle{empty}%
  \singlespacing
  \centering
  \ufrj@logoline\par
  \vspace{1.5cm}
  {\singlespacing
 \MakeUppercase{\local@universityname}\par
   \ifx\ufrj@unitcover\@empty\else
     \nohyphens{\MakeUppercase{\ufrj@unitcover}}\par
   \fi
   \ufrj@letunitstr\ufrj@tmpcover{brazilian}{coverprogram}%
   \MakeUppercase{\ufrj@tmpcover}\par}
  \vspace{\stretch{2}}
  \textbf{\MakeUppercase{\textbf{\@authname\ \@authsurn}}}\par
  \vspace{\stretch{2}}
  \nohyphens{\ufrj@titleblock}\par
  \ufrj@volumeline
  \vspace{\stretch{3}}
  \MakeUppercase{\local@cityname}\par
  \ufrj@docyear
  \end{titlepage}%
}
