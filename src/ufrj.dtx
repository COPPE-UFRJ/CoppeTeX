%
% \textbf{Arquivos na \texttt{raiz/}:}
% \begin{verbatim}
%   ufrj.cls   ufrj.dbx   ufrj.bbx   ufrj.cbx   ufrj.ist
%   brazilian-ufrj.lbx     english-ufrj.lbx
%   coppe-logo.pdf          ufrj-logo.pdf
%   latexmkrc
% \end{verbatim}
