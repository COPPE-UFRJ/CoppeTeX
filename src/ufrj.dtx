% Auto-load language packs for any non-built-in language listed in babelopts.
% Built-ins (brazilian, english) ship their string tables inside ufrj.cls
% (defined just above) and need no extra file; others (spanish/french/italian
% /...) ship as ufrj-lang-<name>.def alongside the class. The dispatcher
% must already be defined when these run, so the loader sits AFTER the tables.
\@for\ufrj@@lang:=\ufrj@babelopts\do{%
  \edef\ufrj@@cur{\ufrj@@lang}%
  \ifx\ufrj@@cur\ufrj@@brazilianstr\else
  \ifx\ufrj@@cur\ufrj@@englishstr\else
    \InputIfFileExists{ufrj-lang-\ufrj@@cur.def}
      {\ClassInfo{ufrj}{Loaded language pack ufrj-lang-\ufrj@@cur.def}}
      {\ClassError{ufrj}
        {Missing language pack 'ufrj-lang-\ufrj@@cur.def'.}
        {Install it next to ufrj.cls, or pick a built-in language.}}%
  \fi\fi}
