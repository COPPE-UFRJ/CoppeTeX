% \subsection{As folhas do trabalho}
%
% Os dados que o autor informa, as três partes do documento e as folhas que a
% classe compõe com esses dados: capa, folha de rosto, folha da Coleta CAPES,
% ficha catalográfica, folha de aprovação, dedicatória, os resumos e o
% colófon.
%
% \subsubsection{A instituição e a unidade}\label{sec:unidade}
%
% A classe sabe o que é da \textbf{UFRJ}: o nome da universidade, a cidade, o
% logotipo da esquerda, o Manual do SiBI. O que é de uma \textbf{unidade} --- o
% nome do instituto ou da escola, os Programas, o logotipo da direita, as
% frases que só aquela unidade escreve e a norma que ela acrescenta ao Manual
% --- a classe não sabe: recebe por declaração, de um \emph{estilo de
% unidade} carregado logo depois dela. O da COPPE é o |ufrj-coppe|, que tem
% fonte e manual próprios, |ufrj-coppe.dtx| e |ufrj-coppe.pdf|, e é o modelo
% para o estilo de outra unidade. Nenhuma parte da classe nomeia unidade
% nenhuma, e sem estilo nenhum ela compõe um trabalho com os textos da UFRJ.
%
% \DescribeMacro{\ufrjdeclareunit}
% |\ufrjdeclareunit|\marg{nome por extenso}\marg{nome na capa}\marg{sigla}
% declara a unidade. O nome por extenso vai, numa linha só, na referência do
% trabalho que abre as folhas de resumo; o nome na capa é o mesmo nome com as
% quebras de linha que a capa usa, escritas com |\\|; a sigla vai na natureza da
% folha de rosto, nos metadados do PDF e na ficha em rascunho.
%
% \DescribeMacro{\ufrjdeclareprogram}
% |\ufrjdeclareprogram|\marg{sigla}\marg{nome em português}\marg{nome em
% inglês} declara um Programa, que o autor escolhe com |\department|\marg{sigla}.
% O nome em inglês só aparece na folha do \emph{abstract}; em todo o resto, e nas
% folhas de resumo em outros idiomas, vai o nome em português, que é o nome
% próprio do Programa.
%
% \DescribeMacro{\ufrjdeclarelogos}
% |\ufrjdeclarelogos|\oarg{altura}\marg{esquerda}\marg{direita} diz quais
% logotipos vão no alto da capa e da folha de rosto, pelo nome do arquivo |.pdf|
% sem a extensão. Um nome vazio tira aquele logotipo. Sem declaração nenhuma,
% vai só o da UFRJ, à esquerda, com 2\,cm de altura: o Anexo~A do Manual marca os
% dois logotipos como opcionais.
%
% \DescribeMacro{\ufrjdeclarenorm}
% |\ufrjdeclarenorm|\marg{artigo}\marg{título} troca a norma que o colofão diz
% seguir. O artigo vem à parte porque a frase é ``em conformidade com
% \meta{artigo} \meta{título}'', e \emph{o} Manual e \emph{a} Norma pedem
% artigos diferentes.
%
% \DescribeMacro{\ufrjdefunitstring}
% |\ufrjdefunitstring|\marg{idioma}\marg{chave}\marg{texto} define um texto da
% unidade num idioma, com precedência sobre a tabela da classe e dos pacotes de
% idioma, não importa qual dos dois foi carregado antes. As chaves que uma
% unidade costuma definir são |tounit|, a quem o trabalho foi apresentado, com a
% contração (``à COPPE/UFRJ''); |sciencename|, o nome do grau (``em
% Ciências''); e |coverprogram|, a linha do Programa na capa. A chave |natureza|,
% a frase da folha de rosto e da folha de aprovação, tem um valor da classe que
% já inclui a sigla da unidade, e raramente precisa ser trocada.
%
%    \begin{macrocode}
% A unidade. \local@instname e o nome que a referencia do resumo sempre usou, e
% ficou com o nome antigo para que nada mais precisasse mudar. Os tres comecam
% vazios com \newcommand*, e nao com \newcommand: a forma sem estrela define uma
% macro \long, e \ifx nunca acha uma macro \long igual a \@empty -- o teste de
% "nenhuma unidade declarada" daria sempre falso.
\newcommand*\local@instname{}
\newcommand*\ufrj@unitcover{}
\newcommand*\ufrj@unitacronym{}
\newcommand\ufrjdeclareunit[3]{%
  \gdef\local@instname{#1}%
  \gdef\ufrj@unitcover{#2}%
  \gdef\ufrj@unitacronym{#3}}
% A sigla dentro das frases da classe. \ufrj@unitsep e o trecho ", COPPE," do
% meio da natureza e da ficha; o espaco do comeco vem sempre, com ou sem unidade,
% para que a frase sem unidade nao grude a virgula na palavra seguinte.
% \ufrj@unitshort e "COPPE/UFRJ", e \ufrj@unitshortrev e "UFRJ/COPPE", a ordem
% da ficha catalografica. Os tres expandem ate o fim, porque vao parar no XMP e
% nos metadados do hyperref.
\newcommand*\ufrj@unitsep{ \ifx\ufrj@unitacronym\@empty\else\ufrj@unitacronym, \fi}
\newcommand*\ufrj@unitshort{%
  \ifx\ufrj@unitacronym\@empty\else\ufrj@unitacronym/\fi UFRJ}
\newcommand*\ufrj@unitshortrev{%
  UFRJ\ifx\ufrj@unitacronym\@empty\else/\ufrj@unitacronym\fi}
% Os logotipos da capa e da folha de rosto. O da UFRJ, a esquerda, e o padrao da
% classe; o da direita e da unidade.
\newcommand*\ufrj@logoheight{2cm}
\newcommand*\ufrj@logoleft{ufrj-logo}
\newcommand*\ufrj@logoright{}
\newcommand\ufrjdeclarelogos[3][2cm]{%
  \gdef\ufrj@logoheight{#1}%
  \gdef\ufrj@logoleft{#2}%
  \gdef\ufrj@logoright{#3}}
% A linha dos logotipos. Nenhum espaco solto entre as pecas: a caixa tem a
% largura da linha, e um espaco a mais empurraria o logotipo da direita.
\newcommand\ufrj@logoline{%
  \makebox[\linewidth]{%
    \ifx\ufrj@logoleft\@empty\else
      \ufrj@logo[\ufrj@logoheight]{\ufrj@logoleft}\fi
    \hfill
    \ifx\ufrj@logoright\@empty\else
      \ufrj@logo[\ufrj@logoheight]{\ufrj@logoright}\fi}}
% Os Programas: cada um guarda o nome nos dois idiomas em que a unidade o tem.
\newcommand\ufrjdeclareprogram[3]{%
  \expandafter\gdef\csname ufrj@prog@#1@brazilian\endcsname{#2}%
  \expandafter\gdef\csname ufrj@prog@#1@english\endcsname{#3}}
% Os textos da unidade, e a leitura deles. A unidade escreve numa tabela propria,
% ufrj@unit@<idioma>@<chave>, e nao na da classe: um pacote de idioma carregado
% DEPOIS dela -- \useufrjlanguage vale no preambulo inteiro -- apagaria o texto
% da unidade com o valor generico do idioma.
\newcommand\ufrjdefunitstring[3]{%
  \expandafter\gdef\csname ufrj@unit@#1@#2\endcsname{#3}}
\newcommand\ufrj@unitstr[2]{%
  \@ifundefined{ufrj@unit@#1@#2}%
    {\@nameuse{ufrj@str@#1@#2}}%
    {\@nameuse{ufrj@unit@#1@#2}}}
% O mesmo com um espaco na frente, ou nada quando o texto nao existe: e o que
% evita "Doutor  (D.Sc.)", com dois espacos, numa unidade que nao da nome ao grau.
\newcommand\ufrj@unitstrsp[2]{%
  \@ifundefined{ufrj@unit@#1@#2}%
    {\@ifundefined{ufrj@str@#1@#2}{}{\ \@nameuse{ufrj@str@#1@#2}}}%
    {\ \@nameuse{ufrj@unit@#1@#2}}}
% No idioma principal, e em portugues quando nem a unidade nem o idioma tem o
% texto. E a regra da identidade institucional: o que nao foi traduzido sai em
% portugues, e nunca em branco.
\newcommand\ufrj@unitstrmain[1]{%
  \@ifundefined{ufrj@unit@\ufrj@mainlang @#1}%
    {\@ifundefined{ufrj@str@\ufrj@mainlang @#1}%
      {\ufrj@unitstr{brazilian}{#1}}%
      {\@nameuse{ufrj@str@\ufrj@mainlang @#1}}}%
    {\@nameuse{ufrj@unit@\ufrj@mainlang @#1}}}
% O texto guardado numa macro, para quem precisa dele assim: o \MakeUppercase da
% capa expande o argumento, e \@ifundefined nao pode ir la dentro.
\newcommand\ufrj@letunitstr[3]{%
  \@ifundefined{ufrj@unit@#2@#3}%
    {\expandafter\let\expandafter#1\csname ufrj@str@#2@#3\endcsname}%
    {\expandafter\let\expandafter#1\csname ufrj@unit@#2@#3\endcsname}}
% A norma do colofao, com o artigo que concorda com ela. O titulo padrao, o do
% Manual do SiBI, esta com o colofao.
\newcommand*\ufrj@finalmanualart{o }
\newcommand\ufrjdeclarenorm[2]{%
  \gdef\ufrj@finalmanualart{#1 }%
  \gdef\ufrjfinalmanual{#2}}
% Os textos institucionais que a classe escreve quando nenhuma unidade diz outra
% coisa. Estao em portugues, e so em portugues, porque sao identidade.
\ufrjdefstring{brazilian}{coverprogram}{Programa de Pós-Graduação em \local@deptname}
\ufrjdefstring{brazilian}{natureza}{\local@doctype\ de \@degreename\
  \ifthenelse{\boolean{maledoc}}{apresentado}{apresentada}
  ao Programa de Pós-graduação em \local@deptname,\ufrj@unitsep
  da \local@universityname, como parte dos requisitos
  necessários à obtenção do título de
  \local@degname\ em \local@deptname.}
%    \end{macrocode}
