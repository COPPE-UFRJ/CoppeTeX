% \begin{macro}{\ufrj@resumocabeca}
% Os quatro elementos que antecedem o texto do resumo, cada um sob o seu
% interruptor. Os três ambientes de resumo chamam este macro: até a v4.1 os
% três traziam o bloco inteiro copiado, byte a byte, e a cópia era o que
% explicava os defeitos daquelas folhas -- uma correção entrava em dois
% lugares e faltava no terceiro, e o terceiro era sempre o
% |brazilianabstract|, que só aparece em trabalho escrito em espanhol.
%
% O idioma de tudo o que se compõe aqui vem de |\ufrj@reslang|, que cada
% ambiente define antes de chamar: \emph{todo} texto de uma folha de resumo --
% o título, a palavra ``Orientadores'', o nome do Programa -- fica no idioma
% daquele resumo. A referência é a exceção conhecida, e está
% explicada em |\ufrj@refresumo|.
%
% Os espaços verticais encolheram na v4.1. Eram 8,6\,mm, 13,2\,mm, 7\,mm,
% 1,5\,cm, 2\,mm, 7\,mm e 5\,mm, que somam 44\,mm de branco antes do texto.
% Agora somam 30\,mm, mais o título. O Manual não prescreve nenhuma dessas
% medidas, e também não prescreve folha única: um resumo de 500 palavras, o
% limite da 3.1.2.1.4, em espaço 1,5 e com os cinco elementos, passa de uma
% folha com ou sem os 14\,mm economizados (issue~\#153).
%    \begin{macrocode}
% O TITULO da folha -- RESUMO, ABSTRACT, RESUMEN --, no idioma daquele resumo,
% vem antes de tudo e nao tem interruptor. A 2.6 poe o resumo entre os titulos
% sem indicativo numerico, que sao centralizados, na mesma lista de
% agradecimentos, sumario e referencias; ate a v4.1 a folha abria direto na
% frase "Resumo da Tese apresentada a COPPE/UFRJ...", alinhada a esquerda
% (#114). O titulo e o que diz ao leitor o que a folha e; a frase de abertura
% (Norma COPPE, secoes 6 a 8) continua, abaixo dele, sob o seu interruptor.
\newcommand\ufrj@res@heading[1]{%
  \begin{center}
    \bfseries\MakeUppercase{\@nameuse{ufrj@str@#1@abstractname}}%
  \end{center}\par
  \vspace*{4mm}}
\newcommand\ufrj@resumocabeca{%
  \ufrj@res@heading{\ufrj@reslang}%
  \if@ufrjresidpag
    \ufrj@toptext{\ufrj@reslang}\par
    \vspace*{6mm}
  \fi
  \if@ufrjrestitulo
    \begin{center}
      \sloppy\nohyphens{\MakeUppercase{\ufrj@res@title{\ufrj@reslang}}%
        \ufrj@res@subtitle{\ufrj@reslang}}\par
      \vspace*{8mm}
      \@authname\ \@authsurn \par
      \vspace*{5mm}
      \ufrj@res@month{\ufrj@reslang}/\ufrj@docyear
    \end{center}\par
    \vspace*{9mm}
  \fi
  \if@ufrjresorient
    \noindent%
    \begin{tabularx}{\textwidth}[b]{@{}l@{ }>{\raggedright\arraybackslash}X@{}}
      \ufrj@res@advisor{\ufrj@reslang}: &
      \count1=0
      \toks@={}
      \@whilenum \count1<\@advisor \do{%
      \ifcase\count1 % same as \ifnum0=\count1
        \toks@=\expandafter{\csname UfrjAdvisorName:\the\count1%
        \expandafter\endcsname\expandafter\space%
        \csname UfrjAdvisorSurname:\the\count1\endcsname\\}
      \else
        \toks@=\expandafter\expandafter\expandafter{%
          \expandafter\the\expandafter\toks@
          \expandafter&\expandafter\space
          \csname UfrjAdvisorName:\the\count1\expandafter\endcsname%
          \expandafter\space\csname UfrjAdvisorSurname:\the\count1\endcsname\\
        }%
      \fi
      \advance\count1 by 1}
      \the\toks@
    \end{tabularx}%
    \ufrj@coadvisorrows{\ufrj@res@coadvisor{\ufrj@reslang}}\par
    \vspace*{2mm}
    \noindent\ufrj@res@deptlabel{\ufrj@reslang}:
      \ufrj@res@deptname{\ufrj@reslang}\par
    \vspace*{5mm}%
  \fi
  \ufrj@refresumo}
%    \end{macrocode}
% \end{macro}
