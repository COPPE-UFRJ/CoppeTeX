%   \item[\texttt{ufrj-lang-spanish.def}, \texttt{spanish-ufrj.lbx}] necessários com a opção
%     |spanish|. O primeiro traz os textos fixos da classe, o segundo os
%     termos de bibliografia.
%   \item[\texttt{ufrj-lang-french.def}, \texttt{french-ufrj.lbx}] o mesmo, para \texttt{french}.
%   \item[\texttt{ufrj-lang-italian.def}, \texttt{italian-ufrj.lbx}] o mesmo, para \texttt{italian}.
%   \item[\texttt{coppe-logo.eps}] só para quem compila pelo caminho antigo,
