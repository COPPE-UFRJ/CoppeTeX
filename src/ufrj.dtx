\newif\if@ufrjsimbalfa \@ufrjsimbalfafalse
\DeclareOption{simbolosalfabeticos}{\@ufrjsimbalfatrue}
\newif\if@ufrjrascunho \@ufrjrascunhofalse
\DeclareOption{rascunhoficha}{\@ufrjrascunhotrue}
