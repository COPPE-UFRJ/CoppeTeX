%     diz qual módulo vai para qual arquivo: no |ufrj.ins|, |class| vira
%     |ufrj.cls| e |bbx| vira |ufrj.bbx|; no |ufrj-coppe.ins|, |package| vira
%     |ufrj-coppe.sty|, |compat| vira |coppe.cls| e |maxexemplo| vira
%     |max-exemplo.tex|; e assim por diante.
% \end{enumerate}
