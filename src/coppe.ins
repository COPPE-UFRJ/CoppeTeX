\input docstrip

\keepsilent
\askforoverwritefalse

\declarepreamble\classpreamble

This is the `coppe' document class used for composition of LaTeX
monographs (master and PhD thesis, and PhD qualifying exams)
satisfying the requirements of the Coordination of Research and
Graduate Courses in Engineering at the Federal University of
Rio de Janeiro.

Copyright (C) 2008 Vicente Helano and George Ainsworth Jr.
Copyright (C) 2024 Vicente Helano and George Ainsworth Jr. and Geraldo Xexéo and Eduardo Mangeli

This program is free software; you can redistribute it and/or modify
it under the terms of the GNU General Public License version 3 as
published by the Free Software Foundation.

This program is distributed in the hope that it will be useful,
but WITHOUT ANY WARRANTY; without even the implied warranty of
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
GNU General Public License version 3 for more details.

You should have received a copy of the GNU General Public License
version 3 along with this package (see COPYING file).
If not, see <http://www.gnu.org/licenses/>.

Author(s): Vicente Helano,
           George Ainsworth
           Geraldo Xexéo
           Eduardo Mangeli

\endpreamble

\declarepreamble\glossarypreamble

This is the makeindex style for creating ordered glossaries
when using the `coppe' document class.

Copyright (C) 2008 Vicente Helano and George Ainsworth Jr.
Copyright (C) 2024 Vicente Helano and George Ainsworth Jr. and Geraldo Xexéo and Eduardo Mangeli

This program is free software; you can redistribute it and/or modify
it under the terms of the GNU General Public License version 3 as
published by the Free Software Foundation.

This program is distributed in the hope that it will be useful,
but WITHOUT ANY WARRANTY; without even the implied warranty of
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
GNU General Public License version 3 for more details.

You should have received a copy of the GNU General Public License
version 3 along with this package (see COPYING file).
If not, see <http://www.gnu.org/licenses/>.

Author(s): Vicente Helano,
           George Ainsworth
           Geraldo Xexéo
           Eduardo Mangeli

\endpreamble

\declarepreamble\examplepreamble

This is a sample monograph which illustrates the use of the `coppe' document
class and its biblatex/biber bibliography style.

\endpreamble

\declarepreamble\bibpreamble

This is a BibLaTeX/biber bibliographic database for the `coppe' document
class.  It is generated from coppe.dtx by docstrip; edit the .dtx source,
not this file.

\endpreamble

\declarepreamble\demopreamble

This is one of the demonstration documents of the `coppe' document class:
the five main-language demos, the PDF/A build of the full example and the
side-by-side cover sheet.  It is generated from coppe.dtx by docstrip; edit
the .dtx source, not this file.

\endpreamble

\declarepreamble\testpreamble

This is a regression test for the `coppe' document class.  Each test is meant
to compile cleanly under pdflatex + biber + pdflatex + pdflatex; the runner
src/tests/run-tests.ps1 discovers every test_*.tex in that directory.  It is
generated from coppe.dtx by docstrip; edit the .dtx source, not this file.

\endpreamble

\postamble
% end of `coppe' customized files
\endpostamble

\usedir{tex/latex/coppe}
\generate{%
  \usepreamble\glossarypreamble
  \file{coppe.ist}{\from{coppe.dtx}{glossary}}%
  \usepreamble\examplepreamble
  \file{example.tex}{\from{coppe.dtx}{example}}%
  \usepreamble\bibpreamble
  \file{example.bib}{\from{coppe.dtx}{examplebib}}%
  \file{coppe.bib}{\from{coppe.dtx}{coppebib}}%
  \usepreamble\classpreamble
  \file{coppe.cls}{\from{coppe.dtx}{class}}%
  \file{coppe.dbx}{\from{coppe.dtx}{dbx}}%
  \file{coppe.bbx}{\from{coppe.dtx}{bbx}}%
  \file{coppe.cbx}{\from{coppe.dtx}{cbx}}%
  \file{brazilian-coppe.lbx}{\from{coppe.dtx}{lbxbr}}%
  \file{english-coppe.lbx}{\from{coppe.dtx}{lbxen}}%
  \file{spanish-coppe.lbx}{\from{coppe.dtx}{lbxes}}%
  \file{french-coppe.lbx}{\from{coppe.dtx}{lbxfr}}%
  \file{italian-coppe.lbx}{\from{coppe.dtx}{lbxit}}%
  \file{coppe-lang-spanish.def}{\from{coppe.dtx}{langes}}%
  \file{coppe-lang-french.def}{\from{coppe.dtx}{langfr}}%
  \file{coppe-lang-italian.def}{\from{coppe.dtx}{langit}}%
  \file{coppe-numeric.bbx}{\from{coppe.dtx}{numbbx}}%
  \file{coppe-numeric.cbx}{\from{coppe.dtx}{numcbx}}%
% Documentos de demonstracao: os cinco idiomas principais, a montagem das
% capas e a versao PDF/A do exemplo completo.
  \usepreamble\demopreamble
  \file{example_pt.tex}{\from{coppe.dtx}{examplept}}%
  \file{example_en.tex}{\from{coppe.dtx}{exampleen}}%
  \file{example_es.tex}{\from{coppe.dtx}{examplees}}%
  \file{example_fr.tex}{\from{coppe.dtx}{examplefr}}%
  \file{example_it.tex}{\from{coppe.dtx}{exampleit}}%
  \file{example_pdfa.tex}{\from{coppe.dtx}{examplepdfa}}%
  \file{covers_5languages.tex}{\from{coppe.dtx}{covers}}%
% Suite de regressao. Fica em src/tests/ porque o \openout do TeX escreve
% em subdiretorio mas nunca em "..".
  \usepreamble\testpreamble
  \file{tests/test_brazilian_one_advisor.tex}{\from{coppe.dtx}{testone}}%
  \file{tests/test_brazilian_two_advisors.tex}{\from{coppe.dtx}{testtwo}}%
  \file{tests/test_brazilian_three_advisors.tex}{\from{coppe.dtx}{testthree}}%
  \file{tests/test_assinaturas.tex}{\from{coppe.dtx}{testassin}}%
  \file{tests/test_assinaturas_7.tex}{\from{coppe.dtx}{testassin7}}%
  \file{tests/test_pdfa.tex}{\from{coppe.dtx}{testpdfa}}%
  \file{tests/test_coorientador.tex}{\from{coppe.dtx}{testcoadv}}%
% O latexmkrc e Perl e nao pode levar o preambulo em %% que o docstrip
% acrescenta por padrao, entao o aviso de arquivo gerado vai dentro do proprio
% modulo, em comentario de Perl.
%
% Sai como latexmkrc.tex, e nao latexmkrc, porque o \openout do TeX acrescenta
% .tex a todo nome sem extensao e recusa nome comecado por ponto: nao ha como
% pedir a ele um arquivo chamado exatamente "latexmkrc". Quem usa
% tools/build-check.ps1 nao precisa fazer nada -- ele poe o arquivo no lugar
% depois de cada geracao. Quem rodar o coppe.ins na mao copia:
%     copy latexmkrc.tex latexmkrc      (Windows)
%     cp   latexmkrc.tex latexmkrc      (Unix)
  \nopreamble
  \nopostamble
  \file{latexmkrc.tex}{\from{coppe.dtx}{latexmkrc}}%
}
\endbatchfile
