% are UTF-8 native, so inputenc must NOT be loaded there (it would clash). Source
% files may use accented Latin characters (áéíóú) directly. Under pdfLaTeX we also
% suggest LuaLaTeX, which handles Unicode/fonts better (at the cost of speed).
\RequirePackage{iftex}
