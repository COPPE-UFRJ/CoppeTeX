% 3.1.4.1 requires the post-textual list to be titled "Referencias", not
% "Bibliografia" (babel's default \bibname). The title is set directly with
% \iflanguage so it is correct in BOTH the chapter heading and the .toc entry:
% \iflanguage resolves to plain text and survives the write to the .toc, whereas
% biblatex's \bibstring does not, and babel's \bibname caption override proved
% unreliable here. Evaluated in the body, the current language is settled.
\defbibheading{bibliography}{%
  \chapter*{\iflanguage{brazilian}{Refer\^encias}{References}}%
  \addcontentsline{toc}{chapter}{\iflanguage{brazilian}{Refer\^encias}{References}}}
% The catalog page range (bib:begin/bib:end) was written by the old
