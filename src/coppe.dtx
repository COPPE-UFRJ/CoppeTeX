% brings it in unconditionally (it must precede hyperref, which is loaded at
% the end of the class). amssymb is the legacy AMS symbol package, built
% around the 8-bit Type 1 fonts msam/msbm; on a Unicode engine (LuaLaTeX or
% XeLaTeX) it clashes with unicode-math, which already provides all of its
% symbols through Unicode math codes. So amssymb is loaded ONLY under
% pdfLaTeX; Unicode-engine users get a ClassWarning pointing them at
% unicode-math (the class does not auto-load unicode-math because choosing
% an OpenType math font is a typographic decision that belongs to the author).
\RequirePackage{amsmath}
\ifPDFTeX
  \RequirePackage{amssymb}
\else
