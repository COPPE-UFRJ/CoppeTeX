% \iffalse
%<*examplept>
\documentclass[dsc]{coppe}
\addbibresource{example.bib}
\begin{document}
  \title{Demonstração da classe CoppeTeX 4.0 em português}
  \foreigntitle{CoppeTeX 4.0 class demonstration in English}
