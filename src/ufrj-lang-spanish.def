%% ufrj-lang-spanish.def -- CoppeTeX 4.x Spanish class-string pack.
%% Loaded by ufrj.cls when \documentclass[spanish]{ufrj} (or any other
%% spanish slot) is active. Populates the dispatcher table for the
%% spanish language and registers the biblatex language mapping.
%% Nothing institutional lives here: the names of the university, the unit and
%% the Programa do not translate, and a unit style declares its own texts with
%% \ufrjdefunitstring, which takes precedence over this table.
\ProvidesFile{ufrj-lang-spanish.def}[2026/09/15 v5.0 CoppeTeX spanish class strings]
%% --- A folha de resumo ------------------------------------------------------
%% Tudo o que a classe escreve numa folha de resumo sai no idioma daquela folha.
%% A frase de abertura e montada de pedacos porque a concordancia muda de idioma
%% para idioma; ver o comentario no ufrj.dtx, na tabela de portugues e ingles.
%%
%% O NOME do Programa nao entra aqui: a unidade o declara em portugues e em
%% ingles, e so. Numa folha neste idioma vai o nome em portugues, que e o nome
%% proprio do Programa. O `tounit' daqui e o da classe sem unidade.
\ufrjdefstring{spanish}{abstractname}     {Resumen}
\ufrjdefstring{spanish}{abstractofmale}   {del}
\ufrjdefstring{spanish}{abstractoffemale} {de la}
\ufrjdefstring{spanish}{presentedmale}    {presentado}
\ufrjdefstring{spanish}{presentedfemale}  {presentada}
\ufrjdefstring{spanish}{tounit}           {a la UFRJ}
\ufrjdefstring{spanish}{abstracttail}{como parte de los
  requisitos necesarios para la obtención del grado de}
