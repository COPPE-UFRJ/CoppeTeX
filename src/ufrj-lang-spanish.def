%% biblatex is loaded by ufrj.cls AFTER this .def file is read; defer the
%% language-mapping registration until \begin{document} so biblatex's
%% \DeclareLanguageMapping is available.
\AtBeginDocument{\DeclareLanguageMapping{spanish}{spanish-ufrj}}

