% but WITHOUT ANY WARRANTY; without even the implied warranty of
% MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
% GNU General Public License version 3 for more details.
%
% You should have received a copy of the GNU General Public License
% version 3 along with this package (see the COPYING.txt file).
% If not, see <http://www.gnu.org/licenses/>.
%
% $URL$
% $Id$
%
% Author(s): Vicente Helano F. Batista
%            George O. Ainsworth Jr.
%            Geraldo Xexéo
%            Eduardo Mangeli
%

\input docstrip

\keepsilent
\askforoverwritefalse

\declarepreamble\classpreamble

This is the `ufrj' document class used for composition of LaTeX
monographs (master's dissertations, PhD theses and qualifying exams)
satisfying the requirements of the Federal University of Rio de
Janeiro (UFRJ), specialized for each academic unit by a unit style.

Copyright (C) 2008-2026 Vicente Helano F. Batista, George O. Ainsworth Jr.,
Geraldo Xexéo and Eduardo Mangeli.

This program is free software; you can redistribute it and/or modify
it under the terms of the GNU General Public License version 3 as
published by the Free Software Foundation.

This program is distributed in the hope that it will be useful,
but WITHOUT ANY WARRANTY; without even the implied warranty of
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
GNU General Public License version 3 for more details.

You should have received a copy of the GNU General Public License
version 3 along with this package (see the COPYING.txt file).
If not, see <http://www.gnu.org/licenses/>.

Author(s): Vicente Helano F. Batista
           George O. Ainsworth Jr.
           Geraldo Xexéo
           Eduardo Mangeli

\endpreamble

\declarepreamble\glossarypreamble

This is the makeindex style for creating ordered glossaries
when using the `ufrj' document class.

Copyright (C) 2008-2026 Vicente Helano F. Batista, George O. Ainsworth Jr.,
Geraldo Xexéo and Eduardo Mangeli.

This program is free software; you can redistribute it and/or modify
it under the terms of the GNU General Public License version 3 as
published by the Free Software Foundation.

This program is distributed in the hope that it will be useful,
but WITHOUT ANY WARRANTY; without even the implied warranty of
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
GNU General Public License version 3 for more details.

You should have received a copy of the GNU General Public License
version 3 along with this package (see the COPYING.txt file).
If not, see <http://www.gnu.org/licenses/>.

Author(s): Vicente Helano F. Batista
           George O. Ainsworth Jr.
           Geraldo Xexéo
           Eduardo Mangeli

\endpreamble

\declarepreamble\bibpreamble

This is a BibLaTeX/biber bibliographic database for the `ufrj' document
class.  It is generated from ufrj.dtx by docstrip; edit the .dtx source,
not this file.

Copyright (C) 2008-2026 Vicente Helano F. Batista, George O. Ainsworth Jr.,
Geraldo Xexéo and Eduardo Mangeli. Released under the GNU General Public
License version 3 (see the COPYING.txt file).

\endpreamble

\postamble
% end of `ufrj' customized files
\endpostamble

\usedir{tex/latex/ufrj}
\generate{%
% A classe nao gera documento nenhum e nao conhece unidade nenhuma. O estilo da
% COPPE, a classe coppe de compatibilidade e os exemplos saem do ufrj-coppe.dtx,
% pelo ufrj-coppe.ins.
  \usepreamble\glossarypreamble
  \file{ufrj.ist}{\from{ufrj.dtx}{glossary}}%
  \usepreamble\bibpreamble
  \file{exemplo.bib}{\from{ufrj.dtx}{examplebib,tiposbib}}%
  \file{manual.bib}{\from{ufrj.dtx}{examplebib}}%
  \file{ufrj.bib}{\from{ufrj.dtx}{ufrjbib}}%
  \usepreamble\classpreamble
  \file{ufrj.cls}{\from{ufrj.dtx}{class}}%
  \file{ufrj.dbx}{\from{ufrj.dtx}{dbx}}%
  \file{ufrj.bbx}{\from{ufrj.dtx}{bbx}}%
  \file{ufrj.cbx}{\from{ufrj.dtx}{cbx}}%
  \file{brazilian-ufrj.lbx}{\from{ufrj.dtx}{lbxbr}}%
  \file{english-ufrj.lbx}{\from{ufrj.dtx}{lbxen}}%
  \file{spanish-ufrj.lbx}{\from{ufrj.dtx}{lbxes}}%
  \file{french-ufrj.lbx}{\from{ufrj.dtx}{lbxfr}}%
  \file{italian-ufrj.lbx}{\from{ufrj.dtx}{lbxit}}%
  \file{ufrj-lang-spanish.def}{\from{ufrj.dtx}{langes}}%
  \file{ufrj-lang-french.def}{\from{ufrj.dtx}{langfr}}%
  \file{ufrj-lang-italian.def}{\from{ufrj.dtx}{langit}}%
  \file{ufrj-numeric.bbx}{\from{ufrj.dtx}{numbbx}}%
  \file{ufrj-numeric.cbx}{\from{ufrj.dtx}{numcbx}}%
% Referencia rapida em ingles: uma tabela com toda opcao, comando e ambiente.
% O manual (ufrj.pdf) e em portugues, porque o leitor dele e o aluno da UFRJ;
% isto e o que serve a quem escreve a tese em ingles ou espanhol, como o art. 57
% da Resolucao CEPG n. 302/2024 permite.
  \file{ufrj-quickref.tex}{\from{ufrj.dtx}{quickref}}%
% O latexmkrc e Perl e nao pode levar o preambulo em %% que o docstrip
% acrescenta por padrao, entao o aviso de arquivo gerado vai dentro do proprio
% modulo, em comentario de Perl.
%
% Sai como latexmkrc.tex, e nao latexmkrc, porque o \openout do TeX acrescenta
% .tex a todo nome sem extensao e recusa nome comecado por ponto: nao ha como
% pedir a ele um arquivo chamado exatamente "latexmkrc". Quem usa
% tools/build-check.ps1 nao precisa fazer nada -- ele poe o arquivo no lugar
% depois de cada geracao. Quem rodar o ufrj.ins na mao copia:
%     copy latexmkrc.tex latexmkrc      (Windows)
%     cp   latexmkrc.tex latexmkrc      (Unix)
  \nopreamble
  \nopostamble
  \file{latexmkrc.tex}{\from{ufrj.dtx}{latexmkrc}}%
}
\endbatchfile
