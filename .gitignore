# CoppeTeX 4.0 working artifacts
_scratch/
specs/*.txt
*.log
*.bcf
*.run.xml
*page-*.png
*.synctex.gz

# Os PDFs de tests/ e de adversativa/ SAO versionados de proposito: quem abre o
# repositorio no GitHub tem de conseguir ver o resultado sem instalar TeX e sem
# compilar nada. Regerar todos com tools\prova.ps1.
/ABNT
/LaTeXManuals
/LIXO
/InstrucoesClaude
/specs/*
!/specs/*.md
!/specs/*.pdf

# Configuração local do Claude Code
.claude/

# metadados XMP gerados pela opcao pdfa
*.xmpdata
*.xmpi

# gerado pelo coppe.ins; o build-check o copia para latexmkrc
src/latexmkrc.tex

# adversativa/: prova de funcionamento, nao distribuida. Entram no git as
# fontes, a base de referencias do Manual e os PDFs; os auxiliares de build,
# nao. Os PDFs entram porque a prova precisa poder ser VISTA sem recompilar.
adversativa/*
!adversativa/*.tex
!adversativa/*.bib
!adversativa/*.pdf
!adversativa/README.md

# listas de floats criados pelo autor com \newcoppefloat (o exemplo cria "mapa")
*.lomapa
# subprodutos do synctex, inclusive o arquivo parcial que fica durante o build
*.synctex
*.synctex(busy)

# arquivo temporario do morewrites: zero byte, produto de build, e um deles
# rastreado no git ja bloqueou a compilacao por conflito de escrita
*.mw
