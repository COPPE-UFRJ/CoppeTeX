\ProvidesFile{ufrj.cbx}[2026/09/15 v5.0 CoppeTeX ABNT author-date citations]
\RequireCitationStyle{authoryear-comp}
\AtEveryCite{%
  \let\mkbibdatelong\ufrj@abntdate
  \let\mkbibdateshort\ufrj@abntdate}

\DeclareDelimFormat{multinamedelim}{\addsemicolon\space}
\DeclareDelimFormat{finalnamedelim}{\addsemicolon\space}
\DeclareDelimFormat[textcite]{multinamedelim}{\addcomma\space}
\DeclareDelimFormat[textcite]{finalnamedelim}{\addspace\bibstring{and}\space}

\DeclareFieldFormat*{citetitle}{#1}
\DeclareDelimFormat{nonameyeardelim}{\addcomma\space}
\ExplSyntaxOn
\seq_new:N \l__ufrj_tit_seq
\tl_new:N \l__ufrj_tit_tl
\tl_new:N \l__ufrj_pal_tl
\tl_const:Nx \c__ufrj_doispontos_tl { \c_colon_str \c_space_tl }
\cs_generate_variant:Nn \seq_set_split:Nnn { NV }
\cs_new_protected:Npn \__ufrj_sem_pontuacao:N #1
  { \regex_replace_once:nnN { [,.;\x{3A}]+ \Z } { } #1 }
\cs_new_protected:Npn \ufrj_titulo_chamada:n #1
  {
    \seq_set_split:NVn \l__ufrj_tit_seq \c__ufrj_doispontos_tl {#1}
    \tl_set:Nx \l__ufrj_tit_tl { \seq_item:Nn \l__ufrj_tit_seq { 1 } }
    \seq_set_split:NnV \l__ufrj_tit_seq { ~ } \l__ufrj_tit_tl
    \seq_remove_all:Nn \l__ufrj_tit_seq { }
    \int_compare:nNnTF { \seq_count:N \l__ufrj_tit_seq } < { 2 }
      {
        \__ufrj_sem_pontuacao:N \l__ufrj_tit_tl
        \l__ufrj_tit_tl
      }
      {
        \seq_pop_left:NN \l__ufrj_tit_seq \l__ufrj_pal_tl
        \ufrj_se_nao_significativa:VT \l__ufrj_pal_tl
          {
            \l__ufrj_pal_tl \c_space_tl
            \seq_pop_left:NN \l__ufrj_tit_seq \l__ufrj_pal_tl
          }
        \__ufrj_sem_pontuacao:N \l__ufrj_pal_tl
        \l__ufrj_pal_tl
        \seq_if_empty:NF \l__ufrj_tit_seq { \c_space_tl [...] \@ }
      }
  }
\cs_set_eq:NN \ufrj@titulochamada \ufrj_titulo_chamada:n
\ExplSyntaxOff
\DeclareFieldFormat{ufrj:titulochamada}{%
  \iffieldundef{shorttitle}{\ufrj@titulochamada{#1}}{#1}}
\renewbibmacro*{cite:label}{%
  \iffieldundef{label}
    {\printtext[bibhyperref]{\printfield[ufrj:titulochamada]{labeltitle}}}
    {\printtext[bibhyperref]{\printfield{label}}}}

\ExplSyntaxOn
\cs_new_protected:Npn \ufrj_entidade_chamada:n #1
  {
    \__ufrj_nome_segmentos:o {#1}
    \seq_item:Nn \l__ufrj_nome_seq { 1 }
  }
\prg_new_protected_conditional:Npnn \ufrj_se_hierarquia:N #1 { TF }
  {
    \__ufrj_nome_segmentos:o {#1}
    \int_compare:nNnTF { \seq_count:N \l__ufrj_nome_seq } > { 1 }
      { \prg_return_true: }
      { \prg_return_false: }
  }
\cs_set_eq:NN \ufrj@entidadechamada \ufrj_entidade_chamada:n
\cs_set_eq:NN \ufrj@sehierarquia \ufrj_se_hierarquia:NTF
\ExplSyntaxOff

\ExecuteBibliographyOptions{uniquename=minyearfull}
\DeclareNameFormat{labelname}{%
  \nameparts{#1}%
  \ifdefvoid{\namepartgiven}
    {\ufrj@sehierarquia\namepartfamily
       {\usebibmacro{name:family}{\ufrj@entidadechamada\namepartfamily}%
          {\namepartgiven}{\namepartprefix}{\namepartsuffix}}%
       {\usebibmacro{name:family}{\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}}}%
    {\usebibmacro{name:family}{\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}}%
  \ifcase\value{uniquename}%
  \or
    \addcomma\space\namepartgiveni
  \or
    \addcomma\space\namepartgiven
  \fi
  \usebibmacro{name:andothers}}

\DeclareRobustCommand{\citetapud}[4][]{%
  #2\space(#3)\space\mkbibemph{apud}\space\textcite[#1]{#4}}
\DeclareRobustCommand{\citepapud}[4][]{%
  \mkbibparens{#2\addcomma\space#3\space\mkbibemph{apud}\space
    \citeauthor{#4}\addcomma\space\citeyear{#4}%
    \ifblank{#1}{}{\addcomma\space\mkpageprefix[pagination]{#1}}}}

