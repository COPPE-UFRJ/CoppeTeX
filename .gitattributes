# Normalização de fim de linha.
#
# O repositório guarda sempre LF; na cópia de trabalho o git entrega o fim de
# linha nativo da plataforma. Sem isto, editar no Windows produz milhares de
# linhas "alteradas" que diferem apenas por CRLF e tornam o diff ilegível.
* text=auto

# Fontes de texto (redundante com text=auto, mas explícito é melhor).
*.tex    text
*.dtx    text
*.ins    text
*.cls    text
*.sty    text
*.bbx    text
*.cbx    text
*.lbx    text
*.dbx    text
*.def    text
*.bib    text
*.ist    text
*.md     text
*.txt    text
LEIAME   text
COPYING.txt  text

# Binários: NUNCA converter fim de linha -- a normalização corrompe o binário.
# Marcados explicitamente mesmo com o `text=auto` lá em cima, porque a
# auto-detecção erra: um binário "de muito texto" (um PDF denso) pode ser visto
# como texto, e um EPS de cabeçalho ASCII idem; aí o git normaliza o LF e
# estraga o arquivo (foi o que corrompeu o Marca_Principal.eps). Defende-se
# tudo o que é ou pode vir a ser binário no projeto.
# Documentos
*.pdf    binary
*.ps     binary
*.eps    binary
*.docx   binary
*.doc    binary
*.xlsx   binary
*.xls    binary
*.pptx   binary
*.ppt    binary
*.odt    binary
*.ods    binary
*.odp    binary
# Imagens
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.tif    binary
*.tiff   binary
*.webp   binary
*.ico    binary
*.xcf    binary
*.psd    binary
*.emf    binary
*.wmf    binary
# Fontes
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.eot    binary
# Compactados e mídia
*.zip    binary
*.gz     binary
*.7z     binary
*.rar    binary
*.tar    binary
*.mp4    binary
*.mp3    binary
*.mov    binary
*.wav    binary

# Scripts precisam do fim de linha da sua plataforma.
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.sh     text eol=lf
Makefile text eol=lf
